{
  "expo": {
    "name": "SNAK",
    "slug": "snack-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SnakIcon.png",
    "scheme": "snackfront",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E0259",
        "foregroundImage": "./assets/images/SnakIcon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tavosalas270.snackfront"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/snack_white.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E0259",
          "dark": {
            "backgroundColor": "#2E0259"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "037839a6-7a21-4841-a03e-87205f23b197"
      }
    }
  }
}
